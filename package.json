{
  "name": "echo-osint",
  "version": "0.2.0",
  "description": "Autonomous Intelligence Engine - OSINT reconnaissance with belief space reasoning",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "api": "ts-node src/api/server.ts",
    "frontend": "npm run build --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "start": "npm run api",
    "start:all": "concurrently \"npm run api\" \"npm run frontend:dev\"",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["osint", "intelligence", "reconnaissance", "autonomous", "infosec"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^8.2.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}